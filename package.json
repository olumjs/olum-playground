{
  "name": "my-app",
  "description": "Olum App",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/gen-versions.js",
    "predev": "node scripts/gen-versions.js",
    "prebuild": "node scripts/gen-versions.js",
    "dev": "npm run css && concurrently -k -n css,app -c magenta,green \"npm run css:watch\" \"npm run dev:app\"",
    "build": "rm -rf ./docs && olum-compiler build && mv ./dist ./docs && echo playground.olumjs.top > ./docs/CNAME",
    "start": "olum-compiler start",
    "css": "tailwindcss -i src/main.css -o public/main.css",
    "css:watch": "npm run css -- --watch",
    "dev:app": "olum-compiler dev"
  },
  "keywords": [
    "olum"
  ],
  "author": "Eissa Saber",
  "license": "ISC",
  "dependencies": {
    "olum": "latest",
    "olum-icons": "latest",
    "olum-router": "latest",
    "olum-store": "latest",
    "olum-transition": "latest",
    "tailwind-merge": "latest"
  },
  "devDependencies": {
    "@tailwindcss/cli": "latest",
    "concurrently": "latest",
    "olum-compiler": "latest",
    "olum-devtool": "latest",
    "tailwindcss": "latest",
    "vite": "latest"
  }
}
